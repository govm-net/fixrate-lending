  "devdoc": {
    "details": "固定利率借贷池，实现ILendingPool接口，可与UnifiedMatchingEngine集成",
    "errors": {
      "OwnableInvalidOwner(address)": [
        {
          "details": "The owner is not a valid owner account. (eg. `address(0)`)"
        }
      ],
      "OwnableUnauthorizedAccount(address)": [
        {
          "details": "The caller account is not authorized to perform an operation."
        }
      ],
      "ReentrancyGuardReentrantCall()": [
        {
          "details": "Unauthorized reentrant call."
        }
      ],
      "SafeERC20FailedOperation(address)": [
        {
          "details": "An operation with an ERC-20 token failed."
        }
      ]
    },
    "kind": "dev",
    "methods": {
      "addSupportedToken(address,address)": {
        "details": "添加支持的代币和其价格预言机",
        "params": {
          "_priceFeed": "价格预言机地址",
          "_token": "代币地址"
        }
      },
      "calculateTokenValue(address,uint256)": {
        "details": "计算代币价值（以USD为单位）",
        "params": {
          "_amount": "代币数量",
          "_token": "代币地址"
        },
        "returns": {
          "_0": "代币价值"
        }
      },
      "checkOrder(address,uint256,address,uint256,uint256,uint256,address)": {
        "details": "检查订单是否可行",
        "params": {
          "_borrower": "借款人地址（未使用）",
          "collateralAmount": "抵押金额",
          "collateralToken": "抵押的代币地址",
          "duration": "借款期限（秒）",
          "interestRate": "利率（基点）",
          "lendAmount": "借出金额",
          "lendToken": "借出的代币地址"
        },
        "returns": {
          "_0": "订单是否可行"
        }
      },
      "deposit(address,uint256)": {
        "details": "向池中存款",
        "params": {
          "_amount": "存款金额",
          "_token": "代币地址"
        }
      },
      "getAvailableBalance(address)": {
        "details": "获取池中可用余额",
        "params": {
          "_token": "代币地址"
        },
        "returns": {
          "_0": "可用余额"
        }
      },
      "getTokenPrice(address)": {
        "details": "获取代币价格（以USD为单位，8位小数）",
        "params": {
          "_token": "代币地址"
        },
        "returns": {
          "_0": "代币价格"
        }
      },
      "isOrderActive(bytes32)": {
        "details": "检查订单是否活跃",
        "params": {
          "_orderHash": "订单哈希"
        },
        "returns": {
          "_0": "是否活跃"
        }
      },
      "lendFromPool(address,uint256,address,uint256,uint256,uint256,address,bytes32)": {
        "details": "从池中借出资金",
        "params": {
          "borrower": "借款人地址",
          "collateralAmount": "抵押金额",
          "collateralToken": "抵押的代币地址",
          "duration": "借款期限（秒）",
          "interestRate": "利率（基点）",
          "lendAmount": "借出金额",
          "lendToken": "借出的代币地址",
          "orderHash": "订单哈希"
        },
        "returns": {
          "_0": "是否成功"
        }
      },
      "removeSupportedToken(address)": {
        "details": "移除支持的代币",
        "params": {
          "_token": "代币地址"
        }
      },
      "repayToPool(address,uint256,bytes32,address)": {
        "details": "向池中还款",
        "params": {
          "borrower": "借款人地址",
          "lendToken": "借出的代币地址",
          "orderHash": "订单哈希",
          "repayAmount": "还款金额（本金+利息）"
        },
        "returns": {
          "_0": "是否成功"
        }
      },
      "setMatchingEngineAddress(address)": {
        "details": "设置匹配引擎合约地址",
        "params": {
          "_matchingEngineAddress": "匹配引擎合约地址"
        }
      },
      "updatePoolParams(uint256,uint256,uint256)": {
        "details": "更新池参数",
        "params": {
          "_maxLoanDuration": "最长借款期限（秒）",
          "_minCollateralRatio": "最低抵押率（基点）",
          "_minInterestRate": "最低接受利率（基点）"
        }
      },
      "updatePriceFeed(address,address)": {
        "details": "更新代币价格预言机",
        "params": {
          "_priceFeed": "价格预言机地址",
          "_token": "代币地址"
        }
      },
      "withdraw(address,uint256)": {
        "details": "从池中提款",
        "params": {
          "_amount": "提款金额",
          "_token": "代币地址"
        }
      }
    },
    "version": 1
  },
